# ── ParcPay web app (public, bundled into the browser — NEVER put secrets here) ──
# Arc network the UI talks to: testnet | mainnet   (default: mainnet)
VITE_ARC_NETWORK=testnet
# Optional override; defaults to the CREATE2 address in src/contracts/parcpay.ts
# VITE_PARCPAY_ADDRESS=0x000000001a03e01a185A6Ab09cd14AeE2398b55c

# ── Deployment (server/CLI only, never VITE_*) ──
# Prefer an encrypted Foundry keystore:  cast wallet import parcpay-deployer --interactive
# Arc Studio scripts (scripts/self-deploy.ts, compass-deploy.ts) read these from .env:
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# DEPLOYER_PRIVATE_KEY=     # testnet only; use a hardware wallet / keystore for mainnet
